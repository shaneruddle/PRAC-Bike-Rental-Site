<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | <%= site.name %></title>
<meta name="description" content="<%= description %>">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;0,900;1,700;1,800;1,900&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=optional">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;0,900;1,700;1,800;1,900&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=optional" rel="stylesheet" media="print" onload="this.media=&#39;all&#39;">
<noscript><link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;0,900;1,700;1,800;1,900&family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=optional" rel="stylesheet"></noscript>

<!-- Open Graph -->
<meta property="og:title" content="<%= title %> | <%= site.name %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="https://<%= site.domain %><%= path || '/' %>">
<meta property="og:image" content="<%= site.logo.square %>">
<meta property="og:site_name" content="<%= site.name %>">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %> | <%= site.name %>">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= site.logo.square %>">

<!-- Canonical -->
<link rel="canonical" href="https://<%= site.domain %><%= path || '/' %>">
<% if (typeof altHref !== 'undefined' && altHref) { %>
<link rel="alternate" hreflang="<%= altLang %>" href="https://<%= site.domain %><%= altHref %>">
<link rel="alternate" hreflang="<%= lang || 'en' %>" href="https://<%= site.domain %><%= path %>">
<% } %>

<!-- Google tag (gtag.js) - GA4 + Google Ads (same property as the booking engine) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-8FHJNX2F1T"></script>
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('set', 'linker', { 'domains': ['pattayarentabike.com', 'app.pattayarentacar.com', 'www.pattayarentacar.com'] });
gtag('config', 'G-8FHJNX2F1T');
gtag('config', 'AW-806173499');
// Enquiry clicks: phone, WhatsApp and email links anywhere on the page.
document.addEventListener('click', function (e) {
  var a = e.target.closest && e.target.closest('a[href]');
  if (!a) return;
  var h = a.getAttribute('href') || '';
  var method = h.indexOf('tel:') === 0 ? 'phone' : h.indexOf('wa.me') !== -1 ? 'whatsapp' : h.indexOf('mailto:') === 0 ? 'email' : null;
  if (method) gtag('event', 'contact_click', { method: method, page_path: location.pathname });
});
</script>

<!-- Styling -->
<link rel="stylesheet" href="/assets/css/main.css?v=<%= buildId %>">
<link rel="icon" type="image/jpeg" href="https://firebasestorage.googleapis.com/v0/b/pattaya-rent-a-car-rebuild.firebasestorage.app/o/PRAB-Icon.jpg?alt=media&token=bef9127c-502f-4f4a-bfe5-038fef2839ba">

<!-- Structured Data -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": site.name,
  "image": [site.logo.square, site.logo.main],
  "telephone": site.contact.phone,
  "email": site.contact.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": site.office.address,
    "addressLocality": "Pattaya City",
    "addressRegion": "Chon Buri",
    "postalCode": "20150",
    "addressCountry": "TH"
  },
  "areaServed": [
    { "@type": "City", "name": "Pattaya City" },
    { "@type": "AdministrativeArea", "name": "Chon Buri" }
  ],
  "geo": { "@type": "GeoCoordinates", "latitude": site.office.lat, "longitude": site.office.lng },
  "hasMap": site.office.googleMapsUrl,
  "url": "https://" + site.domain + "/",
  "openingHours": "Mo-Su 09:00-17:00"
}) %>
</script>
</head>
<body class="font-sans text-ink bg-paper antialiased">

<%- include('components/header', { site }) %>

<main id="main-content">
<%- body %>
</main>

<%- include('components/footer', { site }) %>

<%- include('components/mobile-cta', { site }) %>

<%- include('components/date-picker-overlay') %>

<script src="/assets/js/date-picker.js?v=<%= buildId %>" defer></script>

</body>
</html>
