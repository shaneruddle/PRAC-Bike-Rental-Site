<!-- Breadcrumb -->
<div class="container mx-auto px-6 pt-8 text-xs text-ink/40">
  <a href="<%= lang === 'th' ? '/th/' : '/' %>" class="hover:text-primary transition-colors"><%= ui.home %></a>
  <span class="mx-2">/</span>
  <span class="text-ink/60"><%= bike.name %></span>
</div>

<!-- Hero -->
<section class="py-10 md:py-16 bg-paper">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <span class="eyebrow"><%= bike.engine %> &bull; <%= bike.transmission %></span>
      <h1 class="font-display text-3xl md:text-4xl font-bold mb-4 text-ink"><%= content.h1 %></h1>
      <p class="text-ink/60 text-lg mb-6"><%= content.tagline %></p>
      <% if (bike.price) { %>
      <div class="flex flex-wrap gap-3 mb-8">
        <% [[3, ui.rate3], [7, ui.rate7], [30, ui.rate30]].forEach(function(r) { if (!bike.price[r[0]]) return; %>
        <div class="bg-white rounded-xl border border-black/5 px-4 py-2.5">
          <span class="block text-[10px] font-bold uppercase tracking-widest text-ink/40"><%= r[1] %></span>
          <span class="font-bold text-ink">&#3647;<%= bike.price[r[0]].toLocaleString() %></span><span class="text-ink/50 text-sm"><%= ui.perDay %></span>
        </div>
        <% }); %>
      </div>
      <% } %>
      <div id="search-bikes">
        <%- include('../components/date-picker', { pickerLabels: ui.picker, bikeSlug: bike.slug }) %>
      </div>
    </div>
    <div class="aspect-[4/3] relative overflow-hidden rounded-3xl bg-white">
      <img src="<%= bike.image %>" alt="<%= bike.name %>" class="w-full h-full object-cover" referrerpolicy="no-referrer" loading="eager" fetchpriority="high">
    </div>
  </div>
</section>

<!-- Intro / best-for / body -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-6 max-w-3xl">
    <p class="text-lg text-ink/70 mb-8 leading-relaxed"><%= content.intro %></p>
    <div class="bg-paper rounded-2xl p-6 mb-8 border border-black/5">
      <span class="text-xs font-bold uppercase tracking-widest text-primary"><%= ui.bestFor %></span>
      <p class="text-ink/70 mt-2"><%= content.bestFor %></p>
    </div>
    <% content.body.forEach(function(para) { %>
      <p class="text-ink/70 mb-4 leading-relaxed"><%= para %></p>
    <% }); %>
  </div>
</section>

<!-- FAQ -->
<section class="py-16 bg-paper">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 class="font-display text-2xl font-bold mb-8 text-ink"><%= ui.faqHeading %></h2>
    <% content.faqs.forEach(function(f) { %>
      <details class="border-b border-black/5 py-4">
        <summary class="font-bold cursor-pointer text-ink"><%= f.q %></summary>
        <p class="text-ink/60 mt-2 leading-relaxed"><%= f.a %></p>
      </details>
    <% }); %>
  </div>
</section>

<!-- Cross-links: language switch + back to fleet -->
<section class="py-10 text-center bg-white border-t border-black/5">
  <a href="<%= altPath %>" class="text-primary font-bold text-sm hover:underline"><%= lang === 'th' ? ui.readInEnglish : ui.readInThai %></a>
  <span class="mx-3 text-ink/20">|</span>
  <a href="<%= lang === 'th' ? '/th/#fleet' : '/#fleet' %>" class="text-ink/50 text-sm hover:text-primary transition-colors"><%= ui.viewAllBikes %></a>
  <span class="mx-3 text-ink/20">|</span>
  <a href="<%= lang === 'th' ? '/th/guides/nmax-vs-pcx/' : '/guides/nmax-vs-pcx/' %>" class="text-ink/50 text-sm hover:text-primary transition-colors"><%= ui.compareGuideLink %></a>
  <% if (lang !== 'th') { %>
  <span class="mx-3 text-ink/20">|</span>
  <a href="/monthly-rental/" class="text-ink/50 text-sm hover:text-primary transition-colors">Monthly rentals</a>
  <% } %>
</section>

<!-- Structured data: Product with live per-day offers -->
<%- include('../components/product-schema', { site, bike, prices }) %>

<!-- Structured data: FAQPage -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": content.faqs.map(function (f) {
    return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
  })
}) %>
</script>
