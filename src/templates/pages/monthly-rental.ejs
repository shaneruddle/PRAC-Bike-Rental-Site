<!-- Breadcrumb -->
<div class="container mx-auto px-6 pt-8 text-xs text-ink/40">
  <a href="/" class="hover:text-primary transition-colors">Home</a>
  <span class="mx-2">/</span>
  <span class="text-ink/60"><%= content.h1 %></span>
</div>

<!-- Hero -->
<section class="py-10 md:py-16 bg-paper">
  <div class="container mx-auto px-6 max-w-3xl text-center">
    <h1 class="font-display text-3xl md:text-4xl font-bold mb-4 text-ink"><%= content.h1 %></h1>
    <p class="text-ink/60 text-lg"><%= content.intro %></p>
  </div>
</section>

<!-- Rates -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-6 max-w-4xl">
    <h2 class="font-display text-2xl font-bold mb-2 text-ink text-center">Starting Monthly Rates</h2>
    <p class="text-ink/50 text-center mb-10"><%= content.savingsNote %></p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% fleet.forEach(function(bike) { %>
      <div class="card overflow-hidden hover:shadow-xl transition-all">
        <div class="aspect-[4/3] relative overflow-hidden bg-paper">
          <img src="<%= bike.image %>" alt="<%= bike.name %>" class="w-full h-full object-cover" referrerpolicy="no-referrer" loading="lazy">
          <span class="absolute top-4 left-4 bg-primary text-white text-[10px] font-black px-2.5 py-1.5 rounded-lg shadow-lg"><%= bike.engine %></span>
        </div>
        <div class="p-6">
          <h3 class="font-display text-lg font-bold text-ink mb-1"><a href="/bikes/<%= bike.slug %>/" class="hover:text-primary transition-colors"><%= bike.name %></a></h3>
          <p class="text-primary font-bold text-sm mb-4">From &#3647;<%= bike.monthly.toLocaleString() %>/month</p>
          <a href="/#search-bikes" class="block text-center bg-ink text-white text-xs font-bold px-4 py-2.5 rounded-lg hover:bg-primary transition-colors">Check Availability</a>
        </div>
      </div>
      <% }); %>
    </div>
    <p class="text-ink/40 text-xs text-center mt-8 max-w-xl mx-auto"><%= content.rateNote %></p>
  </div>
</section>

<!-- Benefits -->
<section class="py-16 bg-paper">
  <div class="container mx-auto px-6 max-w-4xl">
    <h2 class="font-display text-2xl font-bold mb-8 text-ink text-center">Why Rent Monthly</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <% content.benefits.forEach(function(b) { %>
      <div class="p-6 bg-white rounded-2xl border border-black/5 space-y-2">
        <h4 class="font-bold text-ink"><%= b.title %></h4>
        <p class="text-sm text-ink/50 leading-relaxed"><%= b.body %></p>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-16 bg-white text-center">
  <div class="container mx-auto px-6 max-w-xl">
    <h2 class="font-display text-2xl font-bold mb-4 text-ink">Get a Monthly Quote</h2>
    <p class="text-ink/60 mb-8">Message us your dates and preferred bike and we'll confirm availability and current pricing.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="<%= site.contact.whatsapp %>" target="_blank" rel="noopener noreferrer" class="bg-whatsapp text-white px-6 py-3 rounded-full text-xs font-black tracking-widest uppercase shadow-lg shadow-whatsapp/20 transition-all active:scale-95 inline-block">WhatsApp Us</a>
      <a href="tel:<%= site.contact.phone.replace(/\s/g, '') %>" class="bg-ink text-white px-6 py-3 rounded-full text-xs font-black tracking-widest uppercase shadow-lg transition-all active:scale-95 inline-block">Call <%= site.contact.phone %></a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-16 bg-paper">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 class="font-display text-2xl font-bold mb-8 text-ink">Frequently Asked Questions</h2>
    <% content.faqs.forEach(function(f) { %>
      <details class="border-b border-black/5 py-4">
        <summary class="font-bold cursor-pointer text-ink"><%= f.q %></summary>
        <p class="text-ink/60 mt-2 leading-relaxed"><%= f.a %></p>
      </details>
    <% }); %>
  </div>
</section>

<!-- Cross-links -->
<section class="py-10 text-center bg-white border-t border-black/5">
  <a href="/#fleet" class="text-ink/50 text-sm hover:text-primary transition-colors">View all bikes</a>
  <span class="mx-3 text-ink/20">|</span>
  <a href="/guides/nmax-vs-pcx/" class="text-ink/50 text-sm hover:text-primary transition-colors">Compare Nmax vs PCX</a>
</section>

<!-- Structured data: FAQPage -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": content.faqs.map(function (f) {
    return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
  })
}) %>
</script>
