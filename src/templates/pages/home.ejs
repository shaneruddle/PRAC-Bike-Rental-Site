          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Rental requirements & policy -->
<section class="py-24 bg-paper">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <span class="eyebrow mx-auto">Before You Book</span>
      <h2 class="font-display text-4xl font-bold mb-4 text-ink">Rental Requirements &amp; Policy</h2>
      <p class="text-ink/50 max-w-2xl mx-auto">Everything you need to know before picking up your bike.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="card p-6 space-y-2">
        <h4 class="font-bold">Documents Required</h4>
        <p class="text-sm text-ink/50 leading-relaxed">Your original passport and a valid driving license.</p>
      </div>
      <div class="card p-6 space-y-2">
        <h4 class="font-bold">Security Deposit</h4>
        <p class="text-sm text-ink/50 leading-relaxed">A 1,000 THB cash deposit is required at pickup, refunded on return.</p>
      </div>
      <div class="card p-6 space-y-2">
        <h4 class="font-bold">Insurance Included</h4>
        <p class="text-sm text-ink/50 leading-relaxed">Every bike comes with compulsory government insurance (Po Lo Bo), covering basic medical costs.</p>
      </div>
      <div class="card p-6 space-y-2">
        <h4 class="font-bold">Helmets Included</h4>
        <p class="text-sm text-ink/50 leading-relaxed">Two helmets are provided with every rental at no extra cost.</p>
      </div>
      <div class="card p-6 space-y-2">
        <h4 class="font-bold">Pickup &amp; Return Only</h4>
        <p class="text-sm text-ink/50 leading-relaxed">All rentals are collected and returned at our Central Pattaya office &mdash; we don't offer hotel delivery.</p>
      </div>
      <div class="card p-6 space-y-2">
        <h4 class="font-bold">Well-Maintained Fleet</h4>
        <p class="text-sm text-ink/50 leading-relaxed">Every bike is regularly serviced and checked before it goes out.</p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-24 bg-white">
  <div class="container mx-auto px-6 max-w-3xl">
    <div class="text-center mb-16">
      <span class="eyebrow mx-auto">Information</span>
      <h2 class="font-display text-4xl font-bold mb-4 text-ink">Common Questions</h2>
    </div>

    <div class="space-y-4">
      <% faqs.forEach(function(faq) { %>
      <details class="bg-paper rounded-2xl border border-black/5 overflow-hidden group">
        <summary class="px-6 py-5 flex items-center justify-between cursor-pointer font-bold text-ink/80 list-none">
          <%= faq.q %>
          <span class="text-primary group-open:rotate-180 transition-transform">&#9662;</span>
        </summary>
        <div class="px-6 pb-6 text-sm text-ink/60 leading-relaxed"><%= faq.a %></div>
      </details>
      <% }); %>
    </div>
  </div>
</section>

<!-- Structured data: FAQPage -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(function(faq) {
    return {
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    };
  })
}) %>
</script>

<!-- Sticky mobile CTA -->
<div class="fixed bottom-0 left-0 right-0 z-40 md:hidden p-4 grid grid-cols-2 gap-3 bg-white/90 backdrop-blur-lg border-t border-black/5" style="padding-bottom: max(1rem, env(safe-area-inset-bottom));">
  <a href="tel:<%= site.contact.phone.replace(/\s/g, '') %>" class="bg-ink text-white flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-sm shadow-xl">Call Now</a>
  <a href="<%= site.contact.whatsapp %>" target="_blank" rel="noopener noreferrer" class="bg-whatsapp text-white flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-sm shadow-xl">WhatsApp</a>
</div>
