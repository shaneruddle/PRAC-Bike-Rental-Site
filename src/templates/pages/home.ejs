<%# Copy comes from src/data/homeCopy.js (t = homeCopy.en or .th). %>
<!-- Hero: headline, then the instant-quote card (right column on desktop, straight after the headline on mobile) -->
<section class="relative pt-8 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-white">
  <div class="absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-primary/10 to-transparent pointer-events-none" aria-hidden="true"></div>
  <div class="container mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_minmax(0,560px)] gap-x-12 gap-y-6 lg:items-center">
      <div class="lg:col-start-1 lg:row-start-1 lg:self-end">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-4 sm:mb-6">
          <div class="flex items-center gap-2 bg-paper px-3 py-1 rounded-full border border-black/5">
            <span class="text-[10px] font-bold text-ink/50 tracking-tight"><%- t.badgeGroup %></span>
          </div>
          <div class="hidden sm:flex items-center gap-1.5 bg-primary/10 px-3 py-1 rounded-full">
            <span class="text-[10px] font-bold text-primary tracking-tight"><%- t.badgeReply %></span>
          </div>
        </div>

        <h1 class="font-display text-[2rem] md:text-6xl font-bold leading-[1.1] text-ink">
          <%- t.h1 %>
        </h1>
      </div>

      <div class="relative scroll-mt-24 lg:col-start-2 lg:row-start-1 lg:row-span-2" id="search-bikes">
        <%- include('../components/quote-builder', { fleet, quoteCopy: t.quote, pickerLabels: t.picker, monthlyHref: t.links.monthly || '/monthly-rental/', buildId }) %>
      </div>

      <div class="lg:col-start-1 lg:row-start-2 lg:self-start">
        <p class="text-lg md:text-xl text-ink/60 leading-relaxed mb-8 max-w-xl">
          <%- t.intro %>
        </p>

        <div class="flex flex-wrap gap-3 sm:gap-4">
          <% t.chips.forEach(function(chip) { %>
          <div class="flex items-center gap-2 text-ink/70 bg-paper px-4 py-2.5 rounded-xl border border-black/5">
            <span class="font-bold text-sm"><%- chip %></span>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trust badges -->
<section class="py-12 bg-paper border-y border-black/5">
  <div class="container mx-auto px-6">
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-70">
      <% t.trust.forEach(function(item) { %>
      <span class="text-xs font-black uppercase tracking-widest text-ink/50"><%- item %></span>
      <% }); %>
    </div>
  </div>
</section>

<!-- Bike finder -->
<%- include('../components/bike-finder', { t, fleet, bikePages, bikeLang, buildId }) %>

<!-- Fleet -->
<section id="fleet" class="py-24 bg-paper">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <span class="eyebrow mx-auto"><%- t.fleet.eyebrow %></span>
      <h2 class="font-display text-4xl font-bold mb-4 text-ink"><%- t.fleet.heading %></h2>
      <p class="text-ink/50 max-w-2xl mx-auto"><%- t.fleet.sub %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% fleet.forEach(function(bike) { %>
      <div class="card overflow-hidden hover:shadow-xl transition-all">
        <div class="aspect-[4/3] relative overflow-hidden bg-paper">
          <img src="<%= bike.image %>" alt="<%= bike.name %>" class="w-full h-full object-cover" referrerpolicy="no-referrer" loading="lazy">
          <span class="absolute top-4 left-4 bg-primary text-white text-[10px] font-black px-2.5 py-1.5 rounded-lg shadow-lg"><%= bike.engine %></span>
        </div>
        <div class="p-6">
          <div class="mb-4">
            <h3 class="font-display text-xl font-bold text-ink"><a href="<%= bike.slug ? t.links.bikePrefix + bike.slug + '/' : '#fleet' %>" class="hover:text-primary transition-colors"><%= bike.name %></a></h3>
            <p class="text-xs text-ink/40 font-bold uppercase tracking-widest"><%= bike.transmission %> <%- t.fleet.transmission %></p>
            <% if (bike.price) { %>
            <p class="text-primary font-bold text-sm mt-2"><%- t.fleet.from %> &#3647;<%= bike.price.from.toLocaleString() %><%- t.fleet.perDay %></p>
            <% } %>
          </div>
          <div class="pt-4 border-t border-black/5">
            <a href="<%= t.links.search %>" data-pick="<%= bike.slug %>" class="block text-center bg-ink text-white text-xs font-bold px-4 py-2.5 rounded-lg hover:bg-primary transition-colors"><%- t.fleet.book %></a>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <p class="mt-8 text-center">
      <a href="<%= t.links.compare %>" class="text-primary font-bold text-sm hover:underline"><%- t.fleet.compareLink %></a>
    </p>
    <% if (prices) { %>
    <p class="mt-2 text-center">
      <a href="/prices/" class="text-primary font-bold text-sm hover:underline"><%- t.fleet.pricesLink %></a>
    </p>
    <% } %>
    <% if (t.links.monthly) { %>
    <p class="mt-2 text-center">
      <a href="<%= t.links.monthly %>" class="text-primary font-bold text-sm hover:underline"><%- t.fleet.monthlyLink %></a>
    </p>
    <% } %>
  </div>
</section>

<!-- Structured data: fleet as Products with live per-day offers (see components/product-schema). -->
<% fleet.forEach(function(bike) { %>
<%- include('../components/product-schema', { site, bike, prices }) %>
<% }); %>

<!-- Testimonials -->
<section class="py-24 bg-ink text-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="font-display text-4xl font-bold mb-4"><%- t.reviews.heading %></h2>
      <p class="text-white/50"><%- t.reviews.sub %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% reviews.forEach(function(review) { %>
      <div class="p-8 bg-white/5 rounded-2xl border border-white/10">
        <div class="mb-6 text-yellow-500">
          <% for (let j = 0; j < review.stars; j++) { %>&#9733;<% } %>
        </div>
        <p class="text-white/70 italic mb-8 leading-relaxed">"<%= review.text %>"</p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center font-bold text-white/50">
            <%= review.name.charAt(0) %>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm"><%= review.name %></span>
            <span class="text-[10px] uppercase tracking-widest text-white/40"><%= review.location %></span>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Rental at a glance: included, bring, how it works, office -->
<%- include('../components/rental-glance', { t, site }) %>

<!-- Area strip: links to the area landing pages -->
<section class="py-12 bg-paper border-y border-black/5">
  <div class="container mx-auto px-4 sm:px-6 text-center">
    <h2 class="font-display text-2xl font-bold mb-2 text-ink"><%- t.areas.heading %></h2>
    <p class="text-sm text-ink/50 mb-6 max-w-xl mx-auto"><%- t.areas.sub %></p>
    <div class="flex flex-wrap justify-center gap-2 sm:gap-3">
      <% areaIndex.forEach(function(a) { %>
      <a href="<%= a.path %>" class="px-4 sm:px-5 py-2.5 rounded-full bg-white border border-black/10 text-sm font-bold text-ink/70 hover:border-primary hover:text-primary transition-colors"><%= a.label %></a>
      <% }); %>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-24 bg-white">
  <div class="container mx-auto px-6 max-w-3xl">
    <div class="text-center mb-16">
      <span class="eyebrow mx-auto"><%- t.faq.eyebrow %></span>
      <h2 class="font-display text-4xl font-bold mb-4 text-ink"><%- t.faq.heading %></h2>
    </div>

    <div class="space-y-4">
      <% faqs.forEach(function(faq) { %>
      <details class="bg-paper rounded-2xl border border-black/5 overflow-hidden group">
        <summary class="px-6 py-5 flex items-center justify-between cursor-pointer font-bold text-ink/80 list-none">
          <%= faq.q %>
          <span class="text-primary group-open:rotate-180 transition-transform">&#9662;</span>
        </summary>
        <div class="px-6 pb-6 text-sm text-ink/60 leading-relaxed"><%= faq.a %></div>
      </details>
      <% }); %>
      <% if (t.faq.guideHref) { %>
      <p class="mt-8 text-center">
      <a href="<%= t.faq.guideHref %>" class="text-primary font-bold text-sm hover:underline"><%- t.faq.guideLink %></a>
      </p>
      <% } %>
    </div>
  </div>
</section>

<!-- Structured data: FAQPage -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(function(faq) {
    return {
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    };
  })
}) %>
</script>
