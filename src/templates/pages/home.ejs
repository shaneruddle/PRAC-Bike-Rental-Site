<!-- Hero -->
<section class="relative pt-16 pb-24 overflow-hidden bg-white">
  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <div class="flex items-center gap-2 bg-paper px-3 py-1 rounded-full border border-black/5">
            <span class="text-[10px] font-bold text-ink/50 tracking-tight">&#9733;&#9733;&#9733;&#9733;&#9733; 1,000+ FIVE-STAR REVIEWS</span>
          </div>
          <div class="flex items-center gap-1.5 bg-primary/10 px-3 py-1 rounded-full">
            <span class="text-[10px] font-bold text-primary tracking-tight">RESPONDS WITHIN 5 MINUTES</span>
          </div>
        </div>

        <h1 class="font-display text-5xl md:text-7xl font-bold leading-[1.1] mb-6 text-ink">
          Premium Bike <br>
          Rentals in <span class="text-primary">Pattaya</span>
        </h1>

        <p class="text-lg md:text-xl text-ink/60 leading-relaxed mb-10 max-w-xl">
          The most trusted motorbike &amp; scooter rental service in the city. Professional maintenance, friendly support, and the best rates guaranteed.
        </p>

        <div class="flex flex-wrap gap-4">
          <div class="flex items-center gap-2 text-ink/70 bg-paper px-4 py-2.5 rounded-xl border border-black/5">
            <span class="font-bold text-sm">16+ Years in Pattaya</span>
          </div>
          <div class="flex items-center gap-2 text-ink/70 bg-paper px-4 py-2.5 rounded-xl border border-black/5">
            <span class="font-bold text-sm">10,000+ Happy Customers</span>
          </div>
          <div class="flex items-center gap-2 text-ink/70 bg-paper px-4 py-2.5 rounded-xl border border-black/5">
            <span class="font-bold text-sm">Helmets Included</span>
          </div>
        </div>
      </div>

      <div class="relative" id="search-bikes">
        <%- include('../components/date-picker') %>
      </div>
    </div>
  </div>
</section>

<!-- Trust badges -->
<section class="py-12 bg-paper border-y border-black/5">
  <div class="container mx-auto px-6">
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-70">
      <span class="text-xs font-black uppercase tracking-widest text-ink/50">Since 2009</span>
      <span class="text-xs font-black uppercase tracking-widest text-ink/50">Over 1,000 Five-Star Reviews</span>
      <span class="text-xs font-black uppercase tracking-widest text-ink/50">Insured Bikes</span>
    </div>
  </div>
</section>

<!-- Fleet -->
<section id="fleet" class="py-24 bg-paper">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <span class="eyebrow mx-auto">Our Fleet</span>
      <h2 class="font-display text-4xl font-bold mb-4 text-ink">Available Motorbikes</h2>
      <p class="text-ink/50 max-w-2xl mx-auto">Well-maintained, reliable bikes for your Pattaya adventure.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% fleet.forEach(function(bike) { %>
      <div class="card overflow-hidden hover:shadow-xl transition-all">
        <div class="aspect-[4/3] relative overflow-hidden bg-paper">
          <img src="<%= bike.image %>" alt="<%= bike.name %>" class="w-full h-full object-cover" referrerpolicy="no-referrer" loading="lazy">
          <span class="absolute top-4 left-4 bg-primary text-white text-[10px] font-black px-2.5 py-1.5 rounded-lg shadow-lg"><%= bike.engine %></span>
        </div>
        <div class="p-6">
          <div class="mb-4">
            <h3 class="font-display text-xl font-bold text-ink"><a href="<%= bike.slug ? '/bikes/' + bike.slug + '/' : '#fleet' %>" class="hover:text-primary transition-colors"><%= bike.name %></a></h3>
            <p class="text-xs text-ink/40 font-bold uppercase tracking-widest"><%= bike.transmission %> Transmission</p>
          </div>
          <div class="pt-4 border-t border-black/5">
            <a href="/#search-bikes" class="block text-center bg-ink text-white text-xs font-bold px-4 py-2.5 rounded-lg hover:bg-primary transition-colors">Book Now</a>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
        <p class="mt-8 text-center">
      <a href="/guides/nmax-vs-pcx/" class="text-primary font-bold text-sm hover:underline">Not sure which scooter to pick? Compare the Nmax vs the PCX &rarr;</a>
    </p>
    <p class="mt-2 text-center">
      <a href="/monthly-rental/" class="text-primary font-bold text-sm hover:underline">Staying a month or longer? See monthly rental rates &rarr;</a>
    </p>
  </div>
</section>

<!-- Structured data: fleet as Products (no pricing — rates are dynamic via the booking
     engine's live quote API and would go stale here; see claude/bike-site-ranking-audit-aug-2026.md.
     aggregateRating (business-wide, matches LocalBusiness/bike-detail pages) keeps these eligible
     for Product rich results per Google's requirement that at least one of offers/review/
     aggregateRating be present. -->
<% fleet.forEach(function(bike) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": bike.name,
  "category": "Motorbike Rental",
  "image": bike.image,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1200"
  }
}) %>
</script>
<% }); %>

<!-- Testimonials -->
<section class="py-24 bg-ink text-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="font-display text-4xl font-bold mb-4">What Our Clients Say</h2>
      <p class="text-white/50">Join thousands of happy travelers who trust us in Pattaya.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% reviews.forEach(function(review) { %>
      <div class="p-8 bg-white/5 rounded-2xl border border-white/10">
        <div class="mb-6 text-yellow-500">
          <% for (let j = 0; j < review.stars; j++) { %>&#9733;<% } %>
        </div>
        <p class="text-white/70 italic mb-8 leading-relaxed">"<%= review.text %>"</p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center font-bold text-white/50">
            <%= review.name.charAt(0) %>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm"><%= review.name %></span>
            <span class="text-[10px] uppercase tracking-widest text-white/40"><%= review.location %></span>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Why us + office -->
