<!-- Generic article page (licence guide, area pages). Content: src/data/guides.js -->
<!-- Breadcrumb -->
<div class="container mx-auto px-6 pt-8 text-xs text-ink/40">
  <a href="/" class="hover:text-primary transition-colors">Home</a>
  <span class="mx-2">/</span>
  <span class="text-ink/60"><%= content.breadcrumb || content.h1 %></span>
</div>

<!-- Hero -->
<section class="py-10 md:py-16 bg-paper">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <% if (content.eyebrow) { %><span class="eyebrow"><%= content.eyebrow %></span><% } %>
      <h1 class="font-display text-3xl md:text-4xl font-bold mb-4 text-ink"><%= content.h1 %></h1>
      <p class="text-ink/60 text-lg"><%= content.intro %></p>
    </div>
    <div id="search-bikes">
      <%- include('../components/date-picker', { bikeSlug: content.slug }) %>
    </div>
  </div>
</section>

<!-- Body -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-6 max-w-3xl">
    <% content.sections.forEach(function(sec) { %>
      <h2 class="font-display text-2xl font-bold mt-10 first:mt-0 mb-4 text-ink"><%= sec.h2 %></h2>
      <% (sec.paras || []).forEach(function(p) { %>
        <p class="text-ink/70 mb-4 leading-relaxed"><%= p %></p>
      <% }); %>
      <% if (sec.list) { %>
        <ul class="list-disc pl-6 mb-4 space-y-2 text-ink/70 leading-relaxed">
          <% sec.list.forEach(function(item) { %><li><%= item %></li><% }); %>
        </ul>
      <% } %>
      <% if (sec.note) { %>
        <div class="bg-paper rounded-2xl p-6 my-6 border border-black/5">
          <p class="text-ink/70 leading-relaxed"><%= sec.note %></p>
        </div>
      <% } %>
    <% }); %>

    <% if (content.sources && content.sources.length) { %>
      <p class="text-xs text-ink/40 mt-10">Sources:
        <% content.sources.forEach(function(s, i) { %><a href="<%= s.url %>" target="_blank" rel="noopener" class="underline hover:text-primary"><%= s.label %></a><%= i < content.sources.length - 1 ? ', ' : '' %><% }); %>.
        Last checked <%= content.checked %>.
      </p>
    <% } %>
  </div>
</section>

<!-- CTA -->
<section class="py-16 bg-paper text-center">
  <div class="container mx-auto px-6 max-w-xl">
    <h2 class="font-display text-2xl font-bold mb-4 text-ink"><%= content.ctaHeading %></h2>
    <p class="text-ink/60 mb-8"><%= content.ctaText %></p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="<%= site.contact.whatsapp %>" target="_blank" rel="noopener noreferrer" class="bg-whatsapp text-white px-6 py-3 rounded-full text-xs font-black tracking-widest uppercase shadow-lg shadow-whatsapp/20 transition-all active:scale-95 inline-block">WhatsApp Us</a>
      <a href="tel:<%= site.contact.phone.replace(/\s/g, '') %>" class="bg-ink text-white px-6 py-3 rounded-full text-xs font-black tracking-widest uppercase shadow-lg transition-all active:scale-95 inline-block">Call <%= site.contact.phone %></a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-6 max-w-3xl">
    <h2 class="font-display text-2xl font-bold mb-8 text-ink">Frequently Asked Questions</h2>
    <% content.faqs.forEach(function(f) { %>
      <details class="border-b border-black/5 py-4">
        <summary class="font-bold cursor-pointer text-ink"><%= f.q %></summary>
        <p class="text-ink/60 mt-2 leading-relaxed"><%= f.a %></p>
      </details>
    <% }); %>
  </div>
</section>

<!-- Cross-links -->
<section class="py-10 text-center bg-paper border-t border-black/5">
  <a href="/#fleet" class="text-ink/50 text-sm hover:text-primary transition-colors">View all bikes</a>
  <% (content.related || []).forEach(function(l) { %>
    <span class="mx-3 text-ink/20">|</span>
    <a href="<%= l.href %>" class="text-ink/50 text-sm hover:text-primary transition-colors"><%= l.label %></a>
  <% }); %>
</section>

<!-- Structured data: FAQPage + BreadcrumbList -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": content.faqs.map(function (f) {
    return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
  })
}) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://" + site.domain + "/" },
    { "@type": "ListItem", "position": 2, "name": content.breadcrumb || content.h1, "item": "https://" + site.domain + content.path }
  ]
}) %>
</script>
