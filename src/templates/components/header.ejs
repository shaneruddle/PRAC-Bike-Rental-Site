<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-black/5 shadow-sm">
  <!-- Sticky top banner -->
  <div class="bg-primary text-white py-2 px-4 text-center text-xs md:text-sm font-bold">
    Limited bikes available this week &mdash; book now to secure your dates!
  </div>

  <div class="container mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 transition-transform hover:scale-[1.02]">
      <img src="<%= site.logo.main %>" alt="<%= site.name %>" class="h-10 w-auto">
    </a>

    <nav class="flex items-center gap-4 md:gap-6">
      <a href="tel:<%= site.contact.phone.replace(/\s/g, '') %>" class="hidden md:flex items-center gap-2 text-sm font-bold text-ink/70 hover:text-primary transition-colors">
        <%= site.contact.phone %>
      </a>
      <a href="<%= site.carRentalUrl %>" class="hidden md:flex items-center gap-2 text-sm font-bold text-ink/70 hover:text-primary transition-colors">
        Rent a Car
      </a>
      <a href="/#search-bikes" class="bg-primary hover:bg-primary-hover text-white px-5 py-2.5 rounded-full text-xs font-black tracking-widest uppercase shadow-lg shadow-primary/20 transition-all active:scale-95">
        Rent Now
      </a>
    </nav>
  </div>
</header>
