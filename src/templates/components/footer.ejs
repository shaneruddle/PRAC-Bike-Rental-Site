<footer class="bg-white border-t border-black/5 py-16 pb-40 md:pb-16">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
      <div class="col-span-2 md:col-span-1">
        <img src="<%= site.logo.main %>" alt="<%= site.name %>" class="h-12 w-auto mb-6" loading="lazy">
        <p class="text-xs text-ink/50 leading-relaxed">
          <%= site.office.label %>: <%= site.office.address %><br>
          Open: <%= site.office.hours %><br>
          Phone / WhatsApp: <a href="tel:<%= site.contact.phone.replace(/\s/g, '') %>" class="hover:text-primary"><%= site.contact.phone %></a>
        </p>
      </div>

      <nav aria-label="Our bikes">
        <span class="block text-xs font-bold text-ink/40 uppercase tracking-widest mb-4">Our Bikes</span>
        <ul class="space-y-2 text-sm">
          <li><a href="/bikes/yamaha-gt-125/" class="text-ink/70 hover:text-primary">Yamaha GT 125</a></li>
          <li><a href="/bikes/yamaha-nmax/" class="text-ink/70 hover:text-primary">Yamaha Nmax</a></li>
          <li><a href="/bikes/honda-pcx/" class="text-ink/70 hover:text-primary">Honda PCX</a></li>
          <li><a href="/bikes/yamaha-aerox/" class="text-ink/70 hover:text-primary">Yamaha Aerox</a></li>
          <li><a href="/monthly-rental/" class="text-ink/70 hover:text-primary">Monthly rental</a></li>
          <li><a href="/motorbike-rental-jomtien/" class="text-ink/70 hover:text-primary">Scooter rental for Jomtien</a></li>
        </ul>
      </nav>

      <nav aria-label="Guides">
        <span class="block text-xs font-bold text-ink/40 uppercase tracking-widest mb-4">Guides</span>
        <ul class="space-y-2 text-sm">
          <li><a href="/guides/nmax-vs-pcx/" class="text-ink/70 hover:text-primary">Nmax vs PCX</a></li>
          <li><a href="/guides/motorbike-insurance-in-thailand/" class="text-ink/70 hover:text-primary">Motorbike insurance in Thailand</a></li>
          <li><a href="/guides/motorbike-licence-thailand/" class="text-ink/70 hover:text-primary">Motorbike licence in Thailand</a></li>
          <li><a href="/th/" class="text-ink/70 hover:text-primary" lang="th">เว็บไซต์ภาษาไทย</a></li>
          <li><a href="/th/guides/nmax-vs-pcx/" class="text-ink/70 hover:text-primary" lang="th">เปรียบเทียบ Nmax กับ PCX</a></li>
          <li><a href="<%= site.carRentalUrl %>" class="text-ink/70 hover:text-primary">Rent a car in Pattaya</a></li>
        </ul>
      </nav>

      <div>
        <span class="block text-xs font-bold text-ink/40 uppercase tracking-widest mb-4">Contact Us</span>
        <div class="flex items-center gap-3">
          <a href="<%= site.contact.whatsapp %>" target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-whatsapp text-white rounded-lg flex items-center justify-center shadow-lg shadow-whatsapp/20" aria-label="WhatsApp">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"/></svg>
          </a>
          <a href="tel:<%= site.contact.phone.replace(/\s/g, '') %>" class="w-10 h-10 bg-ink text-white rounded-lg flex items-center justify-center shadow-lg" aria-label="Phone">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 0 1 2-2h3.3a1 1 0 0 1 .9.7l1.5 4.5a1 1 0 0 1-.5 1.2l-2.3 1.1a11 11 0 0 0 5.5 5.5l1.1-2.3a1 1 0 0 1 1.2-.5l4.5 1.5a1 1 0 0 1 .7.9V19a2 2 0 0 1-2 2h-1C9.7 21 3 14.3 3 6V5z"/></svg>
          </a>
          <a href="mailto:<%= site.contact.email %>" class="w-10 h-10 bg-primary text-white rounded-lg flex items-center justify-center shadow-lg shadow-primary/20" aria-label="Email">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l8 5.3a2 2 0 0 0 2 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/></svg>
          </a>
        </div>
        <p class="text-xs text-ink/50 mt-4">Line: <%= site.contact.lineId %></p>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-black/5">
      <p class="text-ink/30 text-[10px] font-medium tracking-tight text-center md:text-left">
        &copy; <%= new Date().getFullYear() %> PATTAYA RENT A BIKE. PART OF THE PATTAYA RENT A CAR GROUP.
      </p>
    </div>
  </div>
</footer>
