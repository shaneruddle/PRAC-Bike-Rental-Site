<%#
  Instant-quote card: pick a bike by photo, pick dates, see the live price
  from the pricing engine (assets/js/quote.js), then hand off to the booking engine.
  Reuses the date-picker trigger/input ids so date-picker.js drives the calendar;
  data-quote="1" tells it to update the quote on Apply instead of redirecting.
  Build-time prices (data-rates) are the fallback if the live quote can't be fetched.
  Homepage passes the whole fleet; bike pages pass their one bike (no picker, plain
  utm_content=<slug> as before).
%>
<%
  const dp = Object.assign({ pickup: 'Pickup', ret: 'Return', note: 'Book Now, Pay Later' }, (typeof pickerLabels !== 'undefined' && pickerLabels) || {});
  const q = quoteCopy;
  const single = fleet.length === 1;
  const unnumber = s => single ? s.replace(/^\d+\.\s*/, '') : s;
%>
<div class="card-compact !bg-white !p-4 sm:!p-8 shadow-xl shadow-black/5 relative z-20">
  <h2 class="text-xl sm:text-2xl font-black mb-4 sm:mb-5 italic text-ink tracking-tight uppercase"><%- q.heading %></h2>
  <form id="booking-form" data-quote="1" data-source="<%= single ? '' : 'home' %>" data-bike="<%= fleet[0].slug %>"
        data-copy="<%= JSON.stringify(q.js) %>" data-monthly-href="<%= monthlyHref %>">

    <p class="text-[10px] font-black uppercase text-gray-400 mb-2 tracking-widest<%= single ? ' hidden' : '' %>"><%- q.step1 %></p>
    <div class="<%= single ? 'hidden ' : '' %>grid grid-cols-4 gap-1.5 sm:gap-3 mb-5" role="radiogroup" aria-label="<%= q.step1.replace(/^\d+\.\s*/, '') %>">
      <% fleet.forEach(function(bike, i) { %>
      <button type="button" role="radio" aria-checked="<%= i === 0 ? 'true' : 'false' %>"
              class="qb-bike<%= i === 0 ? ' is-selected' : '' %>"
              data-slug="<%= bike.slug %>" data-class="<%= bike.priceClass %>" data-name="<%= bike.name %>" data-short="<%= bike.name.replace(/^(Yamaha|Honda) /, '') %>"
              data-rates="<%= bike.price ? JSON.stringify({ 3: bike.price[3], 7: bike.price[7], 30: bike.price[30] }) : '' %>">
        <span class="qb-check" aria-hidden="true">&#10003;</span>
        <img src="<%= bike.image %>" alt="" class="w-full aspect-square sm:aspect-[3/2] object-cover rounded-lg bg-paper" referrerpolicy="no-referrer">
        <span class="block mt-1.5 text-[11px] sm:text-xs font-black text-ink leading-tight truncate"><%= bike.name.replace(/^(Yamaha|Honda) /, '') %></span>
        <span class="block text-[10px] font-bold text-ink/40 truncate"><span class="hidden sm:inline"><%= bike.engine %> &middot; </span><span class="qb-price text-primary"><% if (bike.price && bike.price[3]) { %>&#3647;<%= bike.price[3] %><%- q.js.perDay %><% } %></span></span>
      </button>
      <% }); %>
    </div>

    <p class="text-[10px] font-black uppercase text-gray-400 mb-2 tracking-widest"><%- unnumber(q.step2) %></p>
    <div class="grid grid-cols-2 gap-2 sm:gap-3 mb-4">
      <button type="button" id="dp-trigger-pickup" class="dp-field is-placeholder !p-3 sm:!p-4" aria-label="<%= dp.pickup %>">
        <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span id="dp-val-pickup" class="truncate text-xs sm:text-sm">&nbsp;</span>
      </button>
      <input type="hidden" name="pickup_date" id="dp-input-pickup" required />
      <input type="hidden" name="pickup_time" id="dp-input-pickup-time" value="09:30" />
      <button type="button" id="dp-trigger-return" class="dp-field is-placeholder !p-3 sm:!p-4" aria-label="<%= dp.ret %>">
        <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span id="dp-val-return" class="truncate text-xs sm:text-sm">&nbsp;</span>
      </button>
      <input type="hidden" name="dropoff_date" id="dp-input-return" required />
      <input type="hidden" name="dropoff_time" id="dp-input-return-time" value="09:30" />
    </div>

    <!-- Live quote (filled by quote.js) -->
    <div id="qb-quote" class="rounded-2xl bg-ink text-white px-4 py-3 sm:px-5 sm:py-4 mb-3 min-h-[76px]" aria-live="polite">
      <div class="flex items-end justify-between gap-3">
        <div class="min-w-0">
          <p id="qb-summary" class="text-[11px] font-bold text-white/60 truncate">&nbsp;</p>
          <p id="qb-rate" class="text-sm font-bold text-white/80">&nbsp;</p>
        </div>
        <div class="text-right shrink-0">
          <p class="text-[10px] font-black uppercase tracking-widest text-white/40"><%- q.total %></p>
          <p id="qb-total" class="font-display text-3xl font-black leading-none">&ndash;</p>
        </div>
      </div>
    </div>

    <!-- Longer-rental nudge (shown by quote.js when a longer rental is cheaper per day) -->
    <button type="button" id="qb-nudge" class="hidden w-full text-left rounded-2xl border-2 border-dashed border-primary/40 bg-primary/5 px-4 py-3 mb-3 text-sm text-ink hover:bg-primary/10 transition-colors"></button>

    <button type="submit" id="qb-cta" class="btn-primary w-full group !py-4">
      <span id="qb-cta-label"><%- q.cta %></span>
      <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </button>
    <p class="text-center text-[10px] text-gray-400 uppercase font-black tracking-tighter mt-3 opacity-70"><%- dp.note %></p>
  </form>
</div>
<%# Deferred, so it runs before date-picker.js (later in the page); it picks up the default dates from date-picker's dp:change event. %>
<script src="/assets/js/quote.js?v=<%= buildId %>" defer></script>
